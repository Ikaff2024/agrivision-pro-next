# ─── AgriVision Pro — Variables d'environnement ───────────────────────────────
# Copier en .env et remplir les valeurs. Ne jamais committer .env.

# ── API ────────────────────────────────────────────────────────────────────────

# JWT — Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CHARS

# Durée du token JWT en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS — origines frontend autorisées (séparées par virgules)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Base de données ────────────────────────────────────────────────────────────

# Dev local sans Docker : laisser vide → SQLite automatique
# Dev avec Docker      : ne pas remplir (docker-compose le gère)
# Production           : postgresql://user:password@host:5432/agrivision
DATABASE_URL=

# ── Docker ────────────────────────────────────────────────────────────────────

# Mot de passe PostgreSQL (utilisé par docker-compose)
POSTGRES_PASSWORD=changeme_en_prod

# pgAdmin (interface web DB, mode dev uniquement)
PGADMIN_EMAIL=admin@agrivision.ci
PGADMIN_PASSWORD=admin
