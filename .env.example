# ─── AgriVision Pro — Variables d'environnement ───────────────────────────────
# Copier en .env et remplir les valeurs. Ne jamais committer .env.

# ── API ────────────────────────────────────────────────────────────────────────

# JWT — Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_64_CHARS

# Durée du token JWT en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS — origines frontend autorisées (séparées par virgules)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Email / SMTP (mot de passe oublié) ─────────────────────────────────────────
# Laisser SMTP_HOST vide => emails non envoyés ; le lien de réinitialisation est
# alors journalisé côté serveur ET renvoyé dans la réponse de /auth/forgot-password
# (filet de sécurité pour récupérer un admin unique en lockout).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agri-vision-pro.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Durée de validité du lien de réinitialisation (minutes)
RESET_TOKEN_EXPIRE_MINUTES=60
# URL de base du frontend pour construire les liens d'email
APP_BASE_URL=https://agrivision-pro-next.netlify.app

# ── Télédétection satellite (gratuit) ─────────────────────────────────────────
# Imagerie Sentinel-2 via Copernicus Data Space Ecosystem (offre gratuite) :
#   1. Créer un compte sur https://dataspace.copernicus.eu
#   2. Dashboard → Sentinel Hub → OAuth clients → créer un client
#   3. Renseigner les identifiants ci-dessous (sinon : indices simulés déterministes)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# Alertes déforestation via Global Forest Watch (gratuit) :
#   https://www.globalforestwatch.org → compte → API key (sinon : signal simulé)
GFW_API_KEY=

# ── Base de données ────────────────────────────────────────────────────────────

# Dev local sans Docker : laisser vide → SQLite automatique
# Dev avec Docker      : ne pas remplir (docker-compose le gère)
# Production           : postgresql://user:password@host:5432/agrivision
DATABASE_URL=

# ── Docker ────────────────────────────────────────────────────────────────────

# Mot de passe PostgreSQL (utilisé par docker-compose)
POSTGRES_PASSWORD=changeme_en_prod

# pgAdmin (interface web DB, mode dev uniquement)
PGADMIN_EMAIL=admin@agrivision.ci
PGADMIN_PASSWORD=admin
